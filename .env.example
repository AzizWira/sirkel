APP_NAME=SIRKEL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirkel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sirkel.local"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
OPENAI_MODEL_ESCALATION=gpt-5.6-terra
OPENAI_MODEL_COMPLEX=gpt-5.6-sol
OPENAI_MONTHLY_BUDGET_USD=20
OPENAI_ESCALATION_CONFIDENCE=0.65
OPENAI_IMAGE_DETAIL=low
OPENAI_CONNECT_TIMEOUT=20
OPENAI_REQUEST_TIMEOUT=60
OPENAI_EXECUTION_TIMEOUT=150
OPENAI_EXECUTION_FALLBACK_BUFFER=8
OPENAI_MAX_ATTEMPTS=2
OPENAI_RETRY_DELAYS_MS=750

BINDERBYTE_API_KEY=
BINDERBYTE_BASE_URL=https://api.binderbyte.com

KTP_RETENTION_DAYS=30
SIRKEL_DEFAULT_PICKUP_RADIUS_KM=10
